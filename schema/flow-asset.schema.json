{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SuperMarioYL/flowcast/schema/flow-asset.schema.json",
  "title": "FlowAsset",
  "description": "A self-describing, parameterized, self-healing capture of a browser walkthrough, persisted as .flow.json.",
  "type": "object",
  "required": ["version", "name", "steps"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1",
      "description": "Schema version of the on-disk flow-asset format."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Friendly name for the flow."
    },
    "description": {
      "type": "string",
      "description": "Optional free-text describing what the flow does."
    },
    "recordedAt": {
      "type": "string",
      "description": "ISO-8601 timestamp of when the flow was first recorded."
    },
    "params": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/definitions/Param" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Step" }
    }
  },
  "definitions": {
    "Param": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Parameter name; a valid identifier referenced as {{key}}."
        },
        "default": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "description": { "type": "string" }
      }
    },
    "SelectorBundle": {
      "type": "object",
      "description": "A bundle of redundant locating clues for one element. Replay tries them in priority order; --heal re-locates when all miss.",
      "additionalProperties": false,
      "properties": {
        "css": { "type": "string", "minLength": 1 },
        "xpath": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "nthOfType": { "type": "integer", "minimum": 0 },
        "tagName": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["css"] },
        { "required": ["xpath"] },
        { "required": ["role", "name"] },
        { "required": ["text"] },
        { "required": ["nthOfType"] }
      ]
    },
    "HealRecord": {
      "type": "object",
      "required": ["at", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "at": { "type": "string", "description": "ISO-8601 timestamp of the heal." },
        "from": { "$ref": "#/definitions/SelectorBundle" },
        "to": { "$ref": "#/definitions/SelectorBundle" },
        "reason": { "type": "string" }
      }
    },
    "Step": {
      "type": "object",
      "required": ["id", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": {
          "type": "string",
          "enum": ["goto", "click", "fill", "select", "waitFor", "extract"]
        },
        "url": { "type": "string", "format": "uri" },
        "target": { "$ref": "#/definitions/SelectorBundle" },
        "value": {
          "type": "string",
          "description": "Value to enter (may contain {{param}} refs). For extract: optional attribute name."
        },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "healHistory": {
          "type": "array",
          "items": { "$ref": "#/definitions/HealRecord" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "goto" } } },
          "then": { "required": ["url"] },
          "else": { "required": ["target"] }
        }
      ]
    }
  }
}
